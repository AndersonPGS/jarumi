{
  "name": "jarumi",
  "productName": "Jarumi",
  "version": "1.0.2",
  "description": "Jarumi — Seus clássicos de celular, de volta. Emulador J2ME com launcher retrô, temas e modo PiP.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "web": "node server.js",
    "build:locales": "node scripts/build-locales.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "pack": "npm run check && npm test && npm run test:e2e && npm run test:pip && electron-builder --dir && npm run test:packaged && npm run test:smoke",
    "dist:win": "npm run pack && electron-builder --win nsis portable --x64 --prepackaged dist/win-unpacked --publish never",
    "export:source": "node scripts/export-source.js",
    "test:e2e": "electron tests/native-e2e.cjs .",
    "test:packaged": "electron tests/native-e2e.cjs dist/win-unpacked/resources/app.asar",
    "test:smoke": "electron tests/smoke-production.cjs",
    "release:check": "node scripts/release-check.js",
    "test:pip": "electron tests/pip-drag.cjs"
  },
  "keywords": [
    "j2me",
    "emulator",
    "midlet",
    "pip",
    "floating-window",
    "retro-gaming",
    "nokia"
  ],
  "author": "",
  "license": "GPL-2.0",
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "app.jarumi.desktop",
    "productName": "Jarumi",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "paths.js",
      "index.html",
      "player.html",
      "icon.ico",
      "icon.png",
      "package.json",
      "js/**/*",
      "css/**/*",
      "assets/**/*",
      "bld/**/*",
      "config/**/*",
      "libs/**/*",
      "polyfill/**/*",
      "style/**/*",
      "java/classes.jar",
      "THIRD_PARTY_NOTICES.md",
      "java/classesold.jar",
      "locales/*.json",
      "LICENSES/**/*"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Jarumi-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Jarumi-${version}-Portable-${arch}.${ext}"
    },
    "compression": "normal"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndersonPGS/jarumi.git"
  },
  "bugs": {
    "url": "https://github.com/AndersonPGS/jarumi/issues"
  },
  "homepage": "https://github.com/AndersonPGS/jarumi#readme"
}
